# Cloudflare Pages headers. Vite copies web/public/ verbatim into web/dist/.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://dolarapi.com; base-uri 'self'; frame-ancestors 'none'

# Vite names every file under /assets/ by a hash of its content: the JS, the CSS and the data
# artifact the page loads (/assets/percentiles.v1-<hash>.json). New content gets a new name, so
# cache these hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The fixed-name copy of the artifact, kept for direct links. "v1" is the schema version, not a
# content hash, so the name stays the same when the data changes: revalidate on every request.
/percentiles.v1.json
  Cache-Control: no-cache

# Short cache on the shell so a redeploy is picked up promptly.
/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
